# =============================================================================
# FUNDAMENTOS DE JOGOS DIGITAIS — Configuração de Ambiente (HostGator PHP + MySQL)
# Copie este arquivo para `.env.local` (ou `.env`) dentro da pasta:
#   /projects/public/fundamentos-de-jogos-digitais/.env.local
# =============================================================================

# --- Banco de Dados MySQL / MariaDB (cPanel -> Bancos de Dados MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=seuusuario_fjd
DB_USER=seuusuario_fjd_user
DB_PASS=sua_senha_forte_do_mysql

# --- URL Pública do Projeto (sem barra no final) ---
APP_BASE_URL=https://projects.vonluqi.com/fundamentos-de-jogos-digitais

# --- Segredo de Cron Jobs (cPanel Cron / /api/cron/sessions-purge) ---
CRON_SECRET=troque_por_um_segredo_longo_aleatorio

# --- Canal de E-mail (Selo do Mensageiro / Recuperação de Palavra) ---
# Opção A: SMTP da própria HostGator (cPanel -> Contas de E-mail)
SMTP_HOST=mail.vonluqi.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mensageiro@vonluqi.com
SMTP_PASS=senha_do_email
MAIL_FROM="Fundamentos de Jogos Digitais <mensageiro@vonluqi.com>"

# Opção B (Opcional): Resend API
RESEND_API_KEY=
RESEND_MAIL_FROM=

# --- Flags Opcionais de Operação ---
AUTH_LOG_SCRYPT=0

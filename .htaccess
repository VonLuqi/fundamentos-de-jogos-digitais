# =============================================================================
# FUNDAMENTOS DE JOGOS DIGITAIS — Apache .htaccess (HostGator cPanel)
# Compatível tanto em raiz de domínio quanto em subdiretório:
#   https://projects.vonluqi.com/fundamentos-de-jogos-digitais
#   (/projects/public/fundamentos-de-jogos-digitais no cPanel)
# =============================================================================

Options -Indexes -MultiViews
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Preserva cabeçalho Authorization em ambientes FastCGI / FPM da HostGator
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # ---------------------------------------------------------------------------
  # 1. Bloqueio de pastas e arquivos sensíveis (segurança)
  # ---------------------------------------------------------------------------
  RewriteRule ^(?:db|scripts|tests|docs|node_modules|\.git|\.cursor|\.github|\.vscode)(?:/|$) - [F,L,NC]
  RewriteRule ^backend/(?!index\.php$) - [F,L,NC]
  RewriteRule ^api/.*\.js$ - [F,L,NC]
  # Entregas do Trabalho Final: nunca servidas diretamente (download só via /api/prova, admin)
  RewriteRule ^uploads/trabalhos(?:/|$) - [F,L,NC]
  RewriteRule ^(?:middleware\.js|local-server\.mjs|migrate-passwords\.js|package(?:-lock)?\.json|vercel\.json)$ - [F,L,NC]

  # ---------------------------------------------------------------------------
  # 2. Rotas da API (/api/* -> backend/index.php)
  # ---------------------------------------------------------------------------
  RewriteRule ^api/?$ backend/index.php?_route= [QSA,L]
  RewriteRule ^api/(.*)$ backend/index.php?_route=$1 [QSA,L]

  # ---------------------------------------------------------------------------
  # 3. URLs limpas das páginas da app (sem /pages/ e sem .html)
  #    Canônico: /despertar/  →  pages/despertar.html
  #    Legado:   /pages/despertar.html e /despertar  →  301 /despertar/
  # ---------------------------------------------------------------------------
  # Slugs = arquivos em pages/*.html (exceto submundo/)
  # THE_REQUEST: só no request do browser (não após rewrite interno).
  # Location absoluta via %1 (prefixo público) — evita /home4/... no HostGator.
  RewriteCond %{THE_REQUEST} ^[A-Z]+\s((?:/[^?\s]+)*)/pages/(auth|dashboard|aulas|aula[1-8]|conquistas|salao-espiritual|grimorio|grimorio-editar|grimorio-nota|companheiro|souls|codigos|despertar|ranking|perfil|classind-dle|prova|prova-admin|guia-trabalho-final)\.html[\s?] [NC]
  RewriteRule ^pages/(auth|dashboard|aulas|aula[1-8]|conquistas|salao-espiritual|grimorio|grimorio-editar|grimorio-nota|companheiro|souls|codigos|despertar|ranking|perfil|classind-dle|prova|prova-admin|guia-trabalho-final)\.html$ %1/%2/ [R=301,L,QSA]

  # Sem barra final → canônico com barra (../css e ../js resolvem na raiz do site)
  RewriteCond %{THE_REQUEST} ^[A-Z]+\s((?:/[^?\s]+)*)/(auth|dashboard|aulas|aula[1-8]|conquistas|salao-espiritual|grimorio|grimorio-editar|grimorio-nota|companheiro|souls|codigos|despertar|ranking|perfil|classind-dle|prova|prova-admin|guia-trabalho-final)(?:\s|\?) [NC]
  RewriteRule ^(auth|dashboard|aulas|aula[1-8]|conquistas|salao-espiritual|grimorio|grimorio-editar|grimorio-nota|companheiro|souls|codigos|despertar|ranking|perfil|classind-dle|prova|prova-admin|guia-trabalho-final)$ %1/%2/ [R=301,L,QSA]

  RewriteRule ^(auth|dashboard|aulas|aula[1-8]|conquistas|salao-espiritual|grimorio|grimorio-editar|grimorio-nota|companheiro|souls|codigos|despertar|ranking|perfil|classind-dle|prova|prova-admin|guia-trabalho-final)/$ pages/$1.html [L,END]

  # ---------------------------------------------------------------------------
  # 4. Rewrites do ARG do Submundo (espelho do vercel.json)
  #    Em subdiretório (ex.: /fundamentos-de-jogos-digitais/submundo/tartaro-oculto),
  #    garante barra final para que os caminhos relativos ../../ do HTML resolvam
  #    para a raiz do projeto.
  # ---------------------------------------------------------------------------
  RewriteCond %{THE_REQUEST} ^[A-Z]+\s((?:/[^?\s]+)*)/(submundo/(?:tartaro-oculto|asfodelos-sussurros|hecate-encruzilhada|elisios-julgamento|persefone-jardim|persefone-estacoes|observatorio-sombras|observatorio-oculto|cocito-espelho|estige-obolo))(?:\s|\?) [NC]
  RewriteRule ^(submundo/(?:tartaro-oculto|asfodelos-sussurros|hecate-encruzilhada|elisios-julgamento|persefone-jardim|persefone-estacoes|observatorio-sombras|observatorio-oculto|cocito-espelho|estige-obolo))$ %1/%2/ [R=302,L]

  RewriteRule ^submundo/tartaro-oculto/?$ pages/submundo/tartaro-oculto.html [L]
  RewriteRule ^submundo/asfodelos-sussurros/?$ pages/submundo/asfodelos-sussurros.html [L]
  RewriteRule ^submundo/hecate-encruzilhada/?$ pages/submundo/hecate-encruzilhada.html [L]
  RewriteRule ^submundo/elisios-julgamento/?$ pages/submundo/elisios-julgamento.html [L]
  RewriteRule ^submundo/persefone-jardim/?$ pages/submundo/persefone-jardim.html [L]
  RewriteRule ^submundo/persefone-estacoes/?$ pages/submundo/persefone-jardim.html [L]
  RewriteRule ^submundo/observatorio-sombras/?$ pages/submundo/observatorio-sombras.html [L]
  RewriteRule ^submundo/observatorio-oculto/?$ pages/submundo/observatorio-sombras.html [L]
  RewriteRule ^submundo/cocito-espelho/?$ pages/submundo/cocito-espelho.html [L]
  RewriteRule ^submundo/estige-obolo/?$ pages/submundo/estige-obolo.html [L]
</IfModule>

# Bloqueia leitura direta de arquivos ocultos (.env, .env.local, .git, etc.)
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Bloqueia arquivos SQL, Markdown e configurações internas
<FilesMatch "\.(sql|md|mjs|lock)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Tipos MIME modernos (WebP, WAV, ES Modules, JSON, PWA manifest)
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType audio/wav .wav
  AddType application/javascript .js .mjs
  AddType application/json .json
  AddType application/manifest+json .webmanifest
  # Modelo 3D da Foice
  AddType model/gltf-binary .glb
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
  # Geometria do GLB comprime ~30% (texturas JPEG já vêm comprimidas)
  AddOutputFilterByType DEFLATE model/gltf-binary
</IfModule>

# Cabeçalhos de Cache e Segurança (compatíveis com raiz ou subdiretório)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Desativa indexação nas salas secretas do Submundo
  <If "%{REQUEST_URI} =~ m#(?:^|/)(?:pages/)?submundo/#">
    Header set X-Robots-Tag "noindex, nofollow"
  </If>

  # Cache longo para assets estáticos (somente em respostas 2xx de sucesso, nunca em 404)
  <If "%{REQUEST_URI} =~ m#(?:^|/)assets/#">
    Header onsuccess set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
  </If>

  # Cache curto para catálogos de dados
  <If "%{REQUEST_URI} =~ m#(?:^|/)data/#">
    Header onsuccess set Cache-Control "public, max-age=60, stale-while-revalidate=300"
  </If>

  # HTML, CSS e JS de aplicação revalidam sempre (evita módulos ES cacheados em versões diferentes).
  # Cloudflare-CDN-Cache-Control / CDN-Cache-Control: o edge da CF ignora max-age próprio (ex.: 14400)
  # e não serve api.js/season-closed.js velhos contra um index.js?v= novo.
  <If "%{REQUEST_URI} =~ m#\.(?:html|js|mjs|css)$#">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set CDN-Cache-Control "no-store"
    Header set Cloudflare-CDN-Cache-Control "no-store"
  </If>
</IfModule>

# Upload do Trabalho Final (.zip até 50 MB). Em PHP-FPM/FastCGI estas diretivas são ignoradas:
# configure upload_max_filesize/post_max_size em .user.ini (ver docs/playbook-liberar-prova-modulo2-e-trabalho-final.md)
<IfModule mod_php.c>
  php_value upload_max_filesize 52M
  php_value post_max_size 56M
  php_value max_execution_time 120
</IfModule>

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "destination": "https://projects.vonluqi.com/fundamentos-de-jogos-digitais/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "destination": "https://projects.vonluqi.com/fundamentos-de-jogos-digitais/:path*",
      "permanent": true
    }
  ],
  "functions": {
    "api/**/*.js": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/cron/sessions-purge",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/warmup",
      "schedule": "45 11 * * 1-5"
    }
  ],
  "rewrites": [
    { "source": "/auth", "destination": "/pages/auth.html" },
    { "source": "/auth/", "destination": "/pages/auth.html" },
    { "source": "/dashboard", "destination": "/pages/dashboard.html" },
    { "source": "/dashboard/", "destination": "/pages/dashboard.html" },
    { "source": "/aulas", "destination": "/pages/aulas.html" },
    { "source": "/aulas/", "destination": "/pages/aulas.html" },
    { "source": "/aula1", "destination": "/pages/aula1.html" },
    { "source": "/aula1/", "destination": "/pages/aula1.html" },
    { "source": "/aula2", "destination": "/pages/aula2.html" },
    { "source": "/aula2/", "destination": "/pages/aula2.html" },
    { "source": "/aula3", "destination": "/pages/aula3.html" },
    { "source": "/aula3/", "destination": "/pages/aula3.html" },
    { "source": "/aula4", "destination": "/pages/aula4.html" },
    { "source": "/aula4/", "destination": "/pages/aula4.html" },
    { "source": "/aula5", "destination": "/pages/aula5.html" },
    { "source": "/aula5/", "destination": "/pages/aula5.html" },
    { "source": "/aula6", "destination": "/pages/aula6.html" },
    { "source": "/aula6/", "destination": "/pages/aula6.html" },
    { "source": "/aula7", "destination": "/pages/aula7.html" },
    { "source": "/aula7/", "destination": "/pages/aula7.html" },
    { "source": "/aula8", "destination": "/pages/aula8.html" },
    { "source": "/aula8/", "destination": "/pages/aula8.html" },
    { "source": "/conquistas", "destination": "/pages/conquistas.html" },
    { "source": "/conquistas/", "destination": "/pages/conquistas.html" },
    { "source": "/salao-espiritual", "destination": "/pages/salao-espiritual.html" },
    { "source": "/salao-espiritual/", "destination": "/pages/salao-espiritual.html" },
    { "source": "/grimorio", "destination": "/pages/grimorio.html" },
    { "source": "/grimorio/", "destination": "/pages/grimorio.html" },
    { "source": "/grimorio-editar", "destination": "/pages/grimorio-editar.html" },
    { "source": "/grimorio-editar/", "destination": "/pages/grimorio-editar.html" },
    { "source": "/grimorio-nota", "destination": "/pages/grimorio-nota.html" },
    { "source": "/grimorio-nota/", "destination": "/pages/grimorio-nota.html" },
    { "source": "/companheiro", "destination": "/pages/companheiro.html" },
    { "source": "/companheiro/", "destination": "/pages/companheiro.html" },
    { "source": "/souls", "destination": "/pages/souls.html" },
    { "source": "/souls/", "destination": "/pages/souls.html" },
    { "source": "/codigos", "destination": "/pages/codigos.html" },
    { "source": "/codigos/", "destination": "/pages/codigos.html" },
    { "source": "/despertar", "destination": "/pages/despertar.html" },
    { "source": "/despertar/", "destination": "/pages/despertar.html" },
    { "source": "/ranking", "destination": "/pages/ranking.html" },
    { "source": "/ranking/", "destination": "/pages/ranking.html" },
    { "source": "/perfil", "destination": "/pages/perfil.html" },
    { "source": "/perfil/", "destination": "/pages/perfil.html" },
    { "source": "/classind-dle", "destination": "/pages/classind-dle.html" },
    { "source": "/classind-dle/", "destination": "/pages/classind-dle.html" },
    { "source": "/prova", "destination": "/pages/prova.html" },
    { "source": "/prova/", "destination": "/pages/prova.html" },
    { "source": "/prova-admin", "destination": "/pages/prova-admin.html" },
    { "source": "/prova-admin/", "destination": "/pages/prova-admin.html" },
    { "source": "/guia-trabalho-final", "destination": "/pages/guia-trabalho-final.html" },
    { "source": "/guia-trabalho-final/", "destination": "/pages/guia-trabalho-final.html" },
    { "source": "/submundo/tartaro-oculto", "destination": "/pages/submundo/tartaro-oculto.html" },
    { "source": "/submundo/asfodelos-sussurros", "destination": "/pages/submundo/asfodelos-sussurros.html" },
    { "source": "/submundo/hecate-encruzilhada", "destination": "/pages/submundo/hecate-encruzilhada.html" },
    { "source": "/submundo/elisios-julgamento", "destination": "/pages/submundo/elisios-julgamento.html" },
    { "source": "/submundo/persefone-jardim", "destination": "/pages/submundo/persefone-jardim.html" },
    { "source": "/submundo/observatorio-sombras", "destination": "/pages/submundo/observatorio-sombras.html" },
    { "source": "/submundo/cocito-espelho", "destination": "/pages/submundo/cocito-espelho.html" },
    { "source": "/submundo/estige-obolo", "destination": "/pages/submundo/estige-obolo.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, stale-while-revalidate=300"
        }
      ]
    },
    {
      "source": "/submundo/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
